{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node", "chrome"]
  },
  "include": ["vite.config.ts", "manifest.ts", "plugins/*.ts"]
}
